generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id               Int      @id @default(autoincrement())
  name             String
  brand            String
  category         String
  price            Float
  imageUrl         String?
  description      String?
  ingredients      String?
  application      String?

  alcoholFree      Boolean  @default(false)
  fragranceFree    Boolean  @default(false)
  vegan            Boolean  @default(false)
  
  rating           Float?   @default(0)
  skinTypes        String? 
  concerns         String?

  wishlistItems WishlistItem[]
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String?

  wishlistItems WishlistItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Order {
  id          Int      @id @default(autoincrement())
  totalPrice  Float
  paymentMethod String
  address     String
  city        String
  postal      String
  country     String
  items       String
  createdAt   DateTime @default(now())
}

model WishlistItem {
  id        Int      @id @default(autoincrement())
  userId    Int
  productId Int
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])

  @@unique([userId, productId])
}

