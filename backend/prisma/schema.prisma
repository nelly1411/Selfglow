generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          Int     @id @default(autoincrement())
  name        String
  brand       String
  category    String
  price       Float
  imageUrl    String?
  description String?
  ingredients String?
  application String?
  size        String?

  alcoholFree   Boolean @default(false)
  fragranceFree Boolean @default(false)
  vegan         Boolean @default(false)

  rating    Float?  @default(0)
  skinTypes String?
  concerns  String?

  wishlistItems WishlistItem[]
  cartItems     CartItem[]
  reviews       Review[]

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  productEmbedding ProductEmbedding?
  aiExplanation    ProductAiExplanation?
}

model User {
  id              Int     @id @default(autoincrement())
  email           String  @unique
  //passwordHash  String
  name            String?
  emailVerified   Boolean @default(false)
  savedAddress    String?
  savedPostal     String?
  savedCity       String?
  savedCountry    String?
  savedPhone      String?
  skinType        String?
  password        String
  usedWelcomeCode Boolean @default(false)
  verificationCode  String?
  verificationCodeExpiry  DateTime?

  wishlistItems WishlistItem[]
  orders        Order[]
  reviews       Review[]
  cart          Cart?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
   gender String? // "male" | "female" | "diverse"
   skinAnalyses SkinAnalysis[]
   conversations Conversation[]
   skinProfileFacts UserSkinProfileFact[]

   profileEmbedding UserProfileEmbedding?
}

model Order {
  id            Int    @id @default(autoincrement())
  orderNumber   String @unique
  totalPrice    Float
  paymentMethod String
  address       String
  city          String
  postal        String
  country       String
  items         String

  userId Int?
  user   User? @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
}

model WishlistItem {
  id        Int      @id @default(autoincrement())
  userId    Int
  productId Int
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([userId, productId])
}

model Cart {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id])
  items CartItem[]
}

model CartItem {
  id        Int      @id @default(autoincrement())
  cartId    Int
  productId Int
  quantity  Int      @default(1)
  selected  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart    @relation(fields: [cartId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([cartId, productId])
}

model Review {
  id         Int      @id @default(autoincrement())
  userId     Int
  productId  Int
  rating     Int
  reviewText String
  createdAt  DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([userId, productId])
}

model ProductEmbedding {
  productId Int                   @id
  content   String
  model     String
  embedding Unsupported("vector")
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductAiExplanation {
  productId   Int      @id
  answer      String   @db.Text
  contentHash String
  model       String
  language    String   @default("de")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model SkinAnalysis {
  id          Int      @id @default(autoincrement())
  userId      Int
  skinType    String
  dryness     Int
  redness     Int
  blemishes   Int
  sensitivity Int
  overall     String
  tips        String   // JSON Array
  products    String   // JSON Array
  imageData   String?  @db.Text
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model UserSkinProfileFact {
  id         Int      @id @default(autoincrement())
  userId     Int
  key        String
  value      String
  source     String   @default("chat")
  confidence Float    @default(0.7)
  evidence   String?  @db.Text
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key, value])
  @@index([userId, key])
}

model Conversation {
  id        String        @id @default(uuid())
  userId    Int
  title     String        @default("Neue Beratung")
  updatedAt DateTime      @updatedAt
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id])
  messages  ChatMessage[]
}

model ChatMessage {
  id             String       @id @default(uuid())
  conversationId String
  role           String
  content        String       @db.Text
  imageData      String?      @db.Text
  products       String?      @db.Text
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model UserProfileEmbedding {
  userId      Int      @id
  content     String   @db.Text
  model       String
  embedding   Unsupported("vector")
  contentHash String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
