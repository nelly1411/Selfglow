generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id               Int      @id @default(autoincrement())
  name             String
  brand            String
  category         String
  price            Float
  imageUrl         String?
  description      String?
  fragranceFree    Boolean  @default(false)
  vegan            Boolean  @default(false)
  naturalCosmetics Boolean  @default(false)
  rating           Float?   @default(0)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}